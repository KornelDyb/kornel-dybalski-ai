---
// "Paragony grozy": trzy znane sytuacje rozpisane jak rachunek. Czasy są przykładowe.
const receipts = [
  {
    title: 'Zapytanie od klienta',
    rows: [
      ['pon 10:12', 'Mail od klienta'],
      ['śr 16:40', 'Twoja odpowiedź'],
    ],
    total: ['Czekał', '2 dni'],
    verdict: 'Wybrał konkurencję',
    text: 'Klient napisał w poniedziałek. Zanim znalazłeś chwilę, miał już ofertę od kogoś innego.',
    tilt: '-2deg',
  },
  {
    title: 'Lista klientów',
    rows: [
      ['1', 'Excel handlowca'],
      ['2', 'Skrzynka szefa'],
      ['3', 'Notes w aucie'],
    ],
    total: ['Wersje prawdy', '3'],
    verdict: 'Nikt nie wie, kto dzwoni',
    text: 'Każdy prowadzi swoją listę. Nikt nie wie, komu obiecano telefon i kto czeka na wycenę.',
    tilt: '1.5deg',
  },
  {
    title: 'Piątkowy raport',
    rows: [
      ['0:40', 'Eksport z systemu'],
      ['1:30', 'Przepisywanie'],
      ['0:50', 'Wykres na poniedziałek'],
    ],
    total: ['Co tydzień', '3 h'],
    verdict: 'Zamiast sprzedaży',
    text: 'Piątkowe popołudnie schodzi na przepisywanie liczb z jednego miejsca w drugie.',
    tilt: '-1deg',
  },
];
---
<section class="section relative overflow-hidden">
  <div class="wrap">
    <h2 class="h-section text-ink">Firma rośnie, a&nbsp;Ty coraz częściej przepisujesz, przypominasz i&nbsp;gonisz</h2>
    <p class="mt-6 max-w-[38rem] text-lg text-ink-soft">Trzy paragony grozy, które zna prawie każda mała firma usługowa.<span class="md:hidden"> Przesuń w bok.</span></p>
    {/* Na telefonie paragony leżą obok siebie w pasku do przesuwania, od tabletu w trzech kolumnach. */}
    <ul class="strip mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pt-4 pb-6 md:mt-16 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:pt-0 md:pb-0 lg:gap-12" tabindex="0" aria-label="Paragony grozy">
      {receipts.map((r) => (
        <li class="flex w-[82%] min-w-0 shrink-0 snap-center flex-col md:w-auto">
          <div class="tilt receipt-shadow" style={`--tilt:${r.tilt}`}>
            <div class="receipt relative">
              <p class="caps text-center font-bold">Paragon grozy</p>
              <p class="text-center text-[0.72rem] text-ink-soft caps">{r.title}</p>
              <div class="rule"></div>
              {r.rows.map(([a, b]) => (
                <div class="row"><span class="text-ink-soft">{a}</span><span>{b}</span></div>
              ))}
              <div class="rule-double"></div>
              <div class="row text-[0.95rem] font-bold"><span class="caps">{r.total[0]}</span><span class="lead" aria-hidden="true"></span><span>{r.total[1]}</span></div>
              <div class="mt-4 text-center">
                <span class="stamp text-[0.95rem]">{r.verdict}</span>
              </div>
            </div>
          </div>
          <p class="mt-7 text-ink-soft">{r.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tilt {
    transform: rotate(var(--tilt));
    transition: transform 500ms var(--ease-out-expo);
  }
  .tilt:hover { transform: rotate(0deg) translateY(-6px); }
  @media (max-width: 767px) {
    /* Pasek sięga krawędzi ekranu, a pierwszy paragon zaczyna się w linii tekstu. */
    .strip { margin-inline: calc(-1 * max(1.25rem, env(safe-area-inset-left, 0px))); padding-inline: max(1.25rem, env(safe-area-inset-left, 0px)); scroll-padding-inline: max(1.25rem, env(safe-area-inset-left, 0px)); scrollbar-width: none; }
    .strip::-webkit-scrollbar { display: none; }
    .strip:focus-visible { outline-offset: -3px; }
  }
</style>
