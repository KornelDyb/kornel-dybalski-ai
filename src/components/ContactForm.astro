---
import { SITE } from '../lib/site.js';
import { COMPANY_SIZES } from '../lib/form.js';

const field = 'mt-2 block w-full rounded-md border-2 border-ink/15 bg-white/70 px-3.5 py-3 text-ink placeholder:text-ink-soft/70 transition-colors hover:border-ink/30 focus:border-cobalt focus:bg-white focus:outline-none aria-[invalid=true]:border-error';
const label = 'block font-mono text-[0.72rem] font-bold tracking-[0.1em] text-ink uppercase';
const error = 'mt-1.5 text-sm font-medium text-error empty:hidden';
---
<section id="kontakt" class="tear-t relative bg-cobalt text-paper">
  <div class="wrap section grid grid-cols-[minmax(0,1fr)] gap-14 lg:grid-cols-[1fr_1.35fr] lg:gap-20">
    <div class="min-w-0 lg:sticky lg:top-28 lg:self-start">
      <h2 class="h-section text-paper">Opowiedz, co chcesz usprawnić</h2>
      <p class="mt-7 max-w-[30rem] text-lg text-cobalt-soft">
        Po wysłaniu dostaniesz maila z linkiem do mojego kalendarza. Sam wybierasz
        termin, a rozmowa trwa około 30 minut. Zmierz, ile czekałeś.
      </p>
      <p class="mt-6 text-cobalt-soft">
        Wolisz napisać od razu?<br />
        <a class="font-semibold text-paper underline decoration-2 underline-offset-[0.3em]" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </div>

    <div class="receipt-shadow min-w-0">
      <form id="contact-form" class="receipt relative font-sans text-base sm:p-9 sm:pb-14" data-email={SITE.email} data-ai-demo={String(SITE.aiDemo)} novalidate>
        <div class="row font-mono text-[0.72rem] font-bold tracking-[0.12em] text-ink-soft uppercase">
          <span>Zgłoszenie</span><span>bezpłatna rozmowa</span>
        </div>
        <div class="rule"></div>

        <div id="form-fields" class="grid gap-5 pt-3 sm:grid-cols-2">
          <div>
            <label for="f-name" class={label}>Imię</label>
            <input id="f-name" name="name" type="text" autocomplete="given-name" required class={field} aria-describedby="e-name" />
            <p id="e-name" class={error} data-error-for="name"></p>
          </div>
          <div>
            <label for="f-email" class={label}>E-mail</label>
            <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required class={field} aria-describedby="e-email" />
            <p id="e-email" class={error} data-error-for="email"></p>
          </div>
          <div>
            <label for="f-company" class={label}>Nazwa firmy</label>
            <input id="f-company" name="company" type="text" autocomplete="organization" required class={field} aria-describedby="e-company" />
            <p id="e-company" class={error} data-error-for="company"></p>
          </div>
          <div>
            <label for="f-size" class={label}>Wielkość firmy</label>
            <select id="f-size" name="size" required class={field} aria-describedby="e-size">
              <option value="">Wybierz</option>
              {COMPANY_SIZES.map((size) => <option value={size}>{size === 'ponad 50' ? 'ponad 50 osób' : `${size} osób`}</option>)}
            </select>
            <p id="e-size" class={error} data-error-for="size"></p>
          </div>
          <div class="sm:col-span-2">
            <label for="f-message" class={label}>Co chcesz usprawnić?</label>
            {SITE.aiDemo && (
              <p id="h-message" class="mt-1.5 text-sm text-ink-soft">
                Im konkretniej, tym lepsze pomysły dostaniesz: ile zapytań, jakich narzędzi używacie, co zabiera najwięcej czasu.
              </p>
            )}
            <textarea id="f-message" name="message" rows="4" required class={field} aria-describedby={SITE.aiDemo ? 'h-message e-message' : 'e-message'} placeholder="Na przykład: dostajemy ok. 30 zapytań tygodniowo przez maila i telefon, odpisujemy po kilku dniach, klientów trzymamy w Excelu."></textarea>
            <p id="e-message" class={error} data-error-for="message"></p>
          </div>

          <!-- Pole-pułapka: ukryte przed ludźmi i czytnikami ekranu. Wypełniają je tylko boty. -->
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="f-website">Strona internetowa</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="sm:col-span-2">
            <label class="flex cursor-pointer items-start gap-3 text-sm text-ink-soft">
              <input name="consent" type="checkbox" required class="mt-0.5 size-[1.15rem] shrink-0 accent-cobalt" aria-describedby="e-consent" />
              <span>
                Zgadzam się na przetwarzanie moich danych w celu odpowiedzi na zgłoszenie i umówienia rozmowy.
                Szczegóły w <a class="link-ink text-ink" href="/polityka-prywatnosci" target="_blank">polityce prywatności</a>.
              </span>
            </label>
            <p id="e-consent" class={error} data-error-for="consent"></p>
            <p class="mt-4 text-[0.8rem] leading-snug text-ink-soft">
              Administratorem danych jest {SITE.name}. Dane z formularza wykorzystam tylko do odpowiedzi
              na zgłoszenie i umówienia rozmowy, przechowuję je do 12 miesięcy od ostatniego kontaktu.
              {SITE.aiDemo && ' Opis z formularza przeanalizuje model AI (OpenAI), żeby przygotować wstępne pomysły.'}{' '}
              Masz prawo do wglądu, poprawienia i usunięcia danych.
              Więcej w <a class="link-ink text-ink" href="/polityka-prywatnosci">polityce prywatności</a>.
            </p>
          </div>

          <div class="sm:col-span-2">
            <div class="rule"></div>
            <button type="submit" class="btn mt-3 w-full text-lg">{SITE.cta}</button>
          </div>
        </div>

        <div id="form-status" class="empty:hidden focus:outline-none" tabindex="-1" role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script>
  import { validate, isBot } from '../lib/form.js';

  const form = document.getElementById('contact-form') as HTMLFormElement;

  function readForm() {
    const fd = new FormData(form);
    return {
      name: String(fd.get('name') ?? ''),
      email: String(fd.get('email') ?? ''),
      company: String(fd.get('company') ?? ''),
      size: String(fd.get('size') ?? ''),
      message: String(fd.get('message') ?? ''),
      consent: fd.get('consent') === 'on',
      website: String(fd.get('website') ?? ''),
    };
  }

  function showErrors(errors: Record<string, string>) {
    form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
      const name = el.dataset.errorFor!;
      el.textContent = errors[name] ?? '';
      const input = form.elements.namedItem(name) as HTMLElement | null;
      input?.setAttribute('aria-invalid', errors[name] ? 'true' : 'false');
    });
    const first = Object.keys(errors)[0];
    if (first) (form.elements.namedItem(first) as HTMLElement | null)?.focus();
  }

  // Po pierwszej próbie wysyłki błędy znikają na bieżąco, gdy pole zostanie poprawione.
  let touched = false;
  form.addEventListener('input', () => {
    if (!touched) return;
    const errors = validate(readForm());
    form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
      const name = el.dataset.errorFor!;
      if (!errors[name] && el.textContent) {
        el.textContent = '';
        (form.elements.namedItem(name) as HTMLElement | null)?.setAttribute('aria-invalid', 'false');
      }
    });
  });

  // Formularz wysyła dane do własnej funkcji na Cloudflare (/api/lead), a dopiero ona do Make.
  // Dzięki temu adresu webhooka nie widać w kodzie strony.
  const ENDPOINT = '/api/lead';
  const AI_DEMO = form.dataset.aiDemo === 'true';
  const CONTACT_EMAIL = form.dataset.email!;
  const status = document.getElementById('form-status')!;
  const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
  const buttonLabel = button.textContent;

  function setStatus(kind: 'sending' | 'success' | 'error' | 'idle') {
    button.disabled = kind === 'sending';
    button.textContent = kind === 'sending' ? 'Wysyłam...' : buttonLabel;
    form.setAttribute('aria-busy', String(kind === 'sending'));

    if (kind === 'error') {
      status.innerHTML = `
        <div class="mt-5 rounded-md border-2 border-error/40 bg-white px-5 py-4">
          <p class="font-semibold text-error">Nie udało się wysłać formularza.</p>
          <p class="mt-1 text-ink-soft">Spróbuj jeszcze raz za chwilę albo napisz bezpośrednio na
            <a class="link-ink text-ink" href="mailto:${CONTACT_EMAIL}">${CONTACT_EMAIL}</a>.</p>
        </div>`;
    } else if (kind !== 'success') {
      status.innerHTML = '';
    }
  }

  // Po wysłaniu blankiet zamienia się w paragon. Pokazuje tylko to, co strona wie na pewno:
  // ile trwało przyjęcie zgłoszenia przez serwer. Mail wysyła Make zaraz potem (w testach ok. 3 s).
  function showReceipt(name: string, company: string, elapsedMs: number) {
    const fields = document.getElementById('form-fields')!;
    const hhmm = new Date().toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
    const seconds = new Intl.NumberFormat('pl-PL', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(elapsedMs / 1000);
    status.innerHTML = `
      <div class="font-mono text-[0.8125rem] leading-[1.8]">
        <div class="row"><span>Od</span><span data-fill="who"></span></div>
        <div class="row"><span>Wysłano</span><span>${hhmm}</span></div>
        <div class="rule"></div>
        <div class="row"><span>Zgłoszenie przyjęte</span><span class="lead"></span><span class="font-bold">OK</span></div>
        <div class="row"><span>Mail z terminami</span><span class="lead"></span><span class="font-bold text-cobalt">wysłany automatycznie</span></div>
        ${AI_DEMO ? '<div class="row"><span>Wstępne pomysły od AI</span><span class="lead"></span><span class="font-bold text-cobalt">w ciągu kilku minut</span></div>' : ''}
        <div class="rule-double"></div>
        <div class="row text-[1rem] font-bold"><span class="uppercase tracking-[0.06em]">Czas przyjęcia</span><span class="lead"></span><span>${seconds} s</span></div>
      </div>
      <p class="mt-6 font-display text-[2rem] leading-none font-bold tracking-tight text-ink">Dzięki!</p>
      <p class="mt-2 text-ink-soft">Sprawdź skrzynkę, za chwilę dostaniesz link do wyboru terminu. Mail zwykle dochodzi w kilka sekund. Nie widzisz go? Zajrzyj do spamu.</p>
      <div class="mt-5"><span class="stamp text-[1.1rem]">Przyjęte</span></div>`;
    (status.querySelector('[data-fill=who]') as HTMLElement).textContent = `${name}, ${company}`;
    fields.hidden = true;
    status.firstElementChild?.animate(
      [{ opacity: 0, transform: 'translateY(-12px)', filter: 'blur(2px)' }, { opacity: 1, transform: 'none', filter: 'blur(0)' }],
      { duration: 500, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
    );
  }

  class ValidationError extends Error {
    constructor(public errors: Record<string, string>) { super('validation'); }
  }

  async function send(data: object) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 15000);
    try {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        signal: controller.signal,
      });
      if (res.status === 422) throw new ValidationError((await res.json()).errors ?? {});
      if (!res.ok) throw new Error(`Serwer odpowiedział ${res.status}`);
    } finally {
      clearTimeout(timeout);
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (button.disabled) return;
    touched = true;
    const data = readForm();
    const errors = validate(data);
    showErrors(errors);
    if (Object.keys(errors).length > 0) return;

    setStatus('sending');
    const sentAt = performance.now();
    try {
      // Botowi udajemy sukces, ale niczego nie wysyłamy.
      if (!isBot(data)) await send(data);
      form.reset();
      touched = false;
      setStatus('success');
      (window as any).umami?.track('formularz-wyslany');
      showReceipt(data.name.trim(), data.company.trim(), performance.now() - sentAt);
    } catch (err) {
      if (err instanceof ValidationError) {
        setStatus('idle');
        showErrors(err.errors);
        return;
      }
      console.error(err);
      setStatus('error');
    }
    status.focus();
  });
</script>
