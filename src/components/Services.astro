---
const areas = [
  {
    name: 'Sprzedaż',
    text: 'Każde zapytanie trafia do jednego miejsca, a handlowiec wie, do kogo zadzwonić najpierw.',
    example: 'Nowe zgłoszenie z formularza w minutę ląduje w CRM, a klient dostaje odpowiedź z linkiem do kalendarza.',
  },
  {
    name: 'Marketing',
    text: 'Treści i kontakty z klientami, które dzieją się regularnie, nawet gdy nie masz na nie czasu.',
    example: 'Klient po zakończonej usłudze dostaje prośbę o opinię, a po trzech miesiącach przypomnienie o przeglądzie.',
  },
  {
    name: 'Obsługa klienta',
    text: 'Powtarzalne pytania dostają szybką odpowiedź, a trudne sprawy trafiają do właściwej osoby.',
    example: 'AI czyta maile przychodzące, odpowiada na pytania o godziny i ceny, a reklamacje przekazuje Tobie.',
  },
];
---
<section id="co-robie" class="section">
  <div class="wrap">
    <div class="grid gap-6 md:grid-cols-[1fr_1fr] md:items-end">
      <div>
        <p class="eyebrow">Co robię</p>
        <h2 class="section-title mt-4">Automatyzacje tam, gdzie tracisz najwięcej czasu</h2>
      </div>
      <p class="max-w-[30rem] text-muted md:justify-self-end">
        Nie sprzedaję narzędzi. Sprawdzam, gdzie Twoja firma traci godziny,
        i wdrażam rozwiązania, które działają na tym, czego już używasz.
      </p>
    </div>
    <div class="mt-14 divide-y divide-line border-y border-line">
      {areas.map((area) => (
        <article class="grid gap-4 py-9 md:grid-cols-[12rem_1fr_1fr] md:gap-10">
          <h3 class="text-3xl">{area.name}</h3>
          <p>{area.text}</p>
          <p class="text-muted">
            <span class="mb-1 block text-xs font-semibold tracking-[0.12em] text-navy uppercase">Przykład</span>
            {area.example}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
