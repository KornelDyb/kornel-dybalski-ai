---
import { SITE } from '../lib/site.js';

// Przykładowy przebieg jednego zgłoszenia: tak działa formularz na tej stronie.
const steps = [
  { t: '00:00', label: 'Formularz wysłany' },
  { t: '00:01', label: 'Filtr antyspamowy' },
  { t: '00:04', label: 'Kontakt w CRM' },
  { t: '00:05', label: 'Szansa „Nowy lead”' },
  { t: '00:41', label: 'Mail z terminami' },
  { t: '00:42', label: 'Powiadomienie dla mnie' },
];
---
<section class="hero tear-b relative z-10 bg-cobalt text-paper">
  <div class="wrap grid grid-cols-[minmax(0,1fr)] items-start gap-14 pt-10 pb-20 md:pt-16 lg:grid-cols-[1.2fr_1fr] lg:gap-10 lg:pt-20 lg:pb-28">
    <div class="min-w-0 lg:pt-10">
      <h1 class="text-[clamp(2.9rem,8.2vw,5.9rem)] text-paper">
        Pokażę Ci, co w&nbsp;Twojej firmie może robić AI
      </h1>
      <p class="mt-7 max-w-[34rem] text-lg text-cobalt-soft md:text-xl">
        Automatyzuję sprzedaż i obsługę klienta w małych firmach usługowych.
        Zapytania dostają odpowiedź w minutę, a nie po dwóch dniach.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-5">
        <a href="#kontakt" class="btn btn-paper text-lg" data-umami-event="cta-naglowek">
          {SITE.cta}
          <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="#dowod" class="font-medium text-paper underline decoration-cobalt-soft/60 decoration-2 underline-offset-[0.3em] hover:decoration-paper">Sprawdź, jak szybko odpowiem</a>
      </div>
      <div class="mt-14 flex items-center gap-4">
        <img src="/profile.webp" alt="" width="540" height="575" class="size-14 rounded-full bg-cobalt-deep object-cover object-top ring-2 ring-paper/80" />
        <p class="leading-snug">
          <span class="block font-semibold">{SITE.name}</span>
          <span class="text-sm text-cobalt-soft">30 minut rozmowy, online, bez zobowiązań</span>
        </p>
      </div>
    </div>

    <!-- Drukarka paragonów: szczelina, z której wysuwa się przebieg zgłoszenia. -->
    <div class="printer relative mx-auto w-full max-w-[24rem] lg:mr-0">
      <div class="printer-head relative z-10 rounded-xl bg-ink px-5 pt-4 pb-5 shadow-[0_24px_40px_-20px_rgb(0_0_0/0.6)]">
        <div class="flex items-center justify-between font-mono text-[0.7rem] tracking-[0.12em] text-paper/60 uppercase">
          <span>Kasa nr 1</span>
          <span class="flex items-center gap-2"><span class="led size-2 rounded-full bg-[#3ddc84]"></span>online</span>
        </div>
        <div class="mt-3 h-2 rounded-full bg-black/70 shadow-[inset_0_2px_3px_rgb(0_0_0/0.8)]"></div>
      </div>
      <div class="feed relative -mt-3 px-3">
        <div class="receipt-shadow">
          <div class="receipt" id="hero-receipt" aria-label="Przykładowy paragon: odpowiedź na zgłoszenie w 42 sekundy">
            <div class="text-center">
              <p class="caps font-bold">{SITE.name}</p>
              <p class="caps text-[0.7rem] text-ink-soft">AI consulting · paragon przykładowy</p>
            </div>
            <div class="rule"></div>
            <div class="row"><span id="hero-who">Zgłoszenie #0142</span><span id="hero-when">pon 09:14</span></div>
            <div class="rule"></div>
            <ol>
              {steps.map((s) => (
                <li class="row p-line" data-t={s.t}>
                  <span class="text-ink-soft">{s.t}</span>
                  <span>{s.label}</span>
                  <span class="lead" aria-hidden="true"></span>
                  <span class="font-bold">OK</span>
                </li>
              ))}
            </ol>
            <div class="rule-double p-line"></div>
            <div class="row p-line text-[0.95rem] font-bold"><span class="caps">Czas odpowiedzi</span><span class="lead" aria-hidden="true"></span><span id="hero-timer">00:42</span></div>
            <div class="row p-line"><span>Twoja praca ręczna</span><span class="lead" aria-hidden="true"></span><span>0 min</span></div>
            <div class="rule p-line"></div>
            <div class="flex items-center justify-between gap-4 pt-1">
              <p class="p-line text-[0.72rem] leading-snug text-ink-soft" id="hero-foot">Tak działa formularz<br />na dole tej strony.</p>
              <span class="stamp text-[1.05rem]" id="hero-stamp">Odpowiedź<br />w 42 s</span>
            </div>
          </div>
        </div>
      </div>
      <form id="personalize" class="mx-3 mt-7" autocomplete="off" data-umami-event="personalizacja">
        <label for="p-company" class="block font-mono text-[0.72rem] font-bold tracking-[0.1em] text-cobalt-soft uppercase">Sprawdź na swojej firmie</label>
        <div class="mt-2 flex gap-2 rounded-lg bg-cobalt-deep/70 p-1.5 ring-1 ring-cobalt-soft/25 focus-within:ring-2 focus-within:ring-paper">
          <input id="p-company" name="company" type="text" maxlength="40" placeholder="Nazwa Twojej firmy" class="min-w-0 flex-1 bg-transparent px-3 text-paper placeholder:text-cobalt-soft/70 focus:outline-none" />
          <button type="submit" class="btn btn-paper min-h-11 shrink-0 px-4 py-2 text-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M7 14h10v7H7z" /></svg>
            Drukuj
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .receipt { position: relative; }
  .led { box-shadow: 0 0 8px #3ddc84; animation: blink 2.4s infinite; }
  @keyframes blink { 50% { opacity: 0.35; } }

  /* Druk: linie wysuwają się z papierem. Bez JS paragon jest pełny od razu. */
  :global(.js) .feed { overflow: hidden; padding-bottom: 3rem; margin-bottom: -3rem; }
  :global(.js) .printing .receipt-shadow { animation: feed 2.7s steps(12, end) both; }
  :global(.js) .printing .p-line { animation: ink 0.35s ease-out both; animation-delay: calc(var(--i) * 0.32s + 0.25s); }
  :global(.js) .printing #hero-stamp { animation: stamp 0.5s var(--ease-out-expo) both; animation-delay: 2.75s; }
  @keyframes feed { from { transform: translateY(-78%); } }
  @keyframes ink { from { opacity: 0; filter: blur(2px); } }
  @keyframes stamp {
    0% { opacity: 0; transform: rotate(-16deg) scale(1.9); filter: blur(4px); }
    70% { opacity: 1; transform: rotate(-6deg) scale(0.94); filter: blur(0); }
    100% { opacity: 1; transform: rotate(-7deg) scale(1); }
  }
</style>

<script>
  const printer = document.querySelector('.printer') as HTMLElement;
  const lines = printer.querySelectorAll<HTMLElement>('.p-line');
  const timer = document.getElementById('hero-timer')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  lines.forEach((el, i) => el.style.setProperty('--i', String(i)));

  // Licznik czasu odpowiedzi biegnie razem z drukiem i zatrzymuje się na 00:42.
  function runTimer() {
    const end = 42;
    const duration = 2600;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / duration);
      const s = Math.round(end * (1 - Math.pow(1 - p, 3)));
      timer.textContent = `00:${String(s).padStart(2, '0')}`;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function print() {
    if (reduce) return;
    printer.classList.remove('printing');
    void printer.offsetWidth;
    printer.classList.add('printing');
    runTimer();
  }

  print();

  // Odwiedzający wpisuje swoją firmę: paragon drukuje się od nowa dla niego,
  // a nazwa trafia od razu do formularza kontaktowego.
  const who = document.getElementById('hero-who')!;
  const when = document.getElementById('hero-when')!;
  const foot = document.getElementById('hero-foot')!;
  const input = document.getElementById('p-company') as HTMLInputElement;
  document.getElementById('personalize')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = input.value.trim();
    if (name) {
      who.textContent = name.length > 20 ? `${name.slice(0, 19)}…` : name;
      when.textContent = new Date().toLocaleString('pl-PL', { weekday: 'short', hour: '2-digit', minute: '2-digit' });
      foot.innerHTML = 'Tak odpowiem Twojemu<br />klientowi. Codziennie.';
      const company = document.getElementById('f-company') as HTMLInputElement | null;
      if (company && !company.value) company.value = name;
    }
    print();
  });
</script>
