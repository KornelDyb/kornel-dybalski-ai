---
import { SITE } from '../lib/site.js';

const faq = [
  {
    q: 'Ile to kosztuje?',
    a: `Rozmowa jest bezpłatna. Wdrożenia zaczynają się od ${SITE.priceFrom}, a dokładną cenę znasz, zanim cokolwiek zaczniemy. Jeśli rozwiązanie nie będzie działać tak, jak ustaliliśmy, oddam pieniądze.`,
  },
  {
    q: 'Ile to trwa?',
    a: 'Prosta automatyzacja, na przykład odpowiedź na zapytania z formularza, to zwykle tydzień. Większe wdrożenia trwają do miesiąca. Termin ustalamy w planie.',
  },
  {
    q: 'Czy muszę znać się na technologii?',
    a: 'Nie. Ty znasz swoją firmę i klientów, ja zajmuję się techniką. Wszystko tłumaczę po ludzku, a po wdrożeniu pokazuję zespołowi, jak z tego korzystać.',
  },
  ...(SITE.aiDemo ? [{
    q: 'Czy pomysły od AI to gotowa oferta?',
    a: 'Nie. To wstępny szkic przygotowany przez AI wyłącznie na podstawie opisu z formularza, bez znajomości szczegółów Twojej firmy. Pokazuje kierunek. Na rozmowie sprawdzamy, co z tego ma sens, a co trzeba zrobić inaczej.',
  }] : []),
  {
    q: 'Co dzieje się z danymi moich klientów?',
    a: 'Dane zostają w narzędziach, z których korzystasz, albo w takich, które razem wybierzemy. Korzystam tylko z usług zgodnych z RODO i niczego nie udostępniam dalej.',
  },
  {
    q: 'A jeśli moja firma jest za mała?',
    a: 'Najlepiej sprawdzić to na rozmowie. Często właśnie w firmach od 5 do 20 osób jedna automatyzacja oszczędza najwięcej, bo każdy robi tam kilka rzeczy naraz.',
  },
];
---
<section id="faq" class="section bg-paper-shade">
  <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
    <div class="min-w-0">
      <h2 class="h-section text-ink">Zanim napiszesz</h2>
      <p class="mt-6 text-lg text-ink-soft">
        Nie ma tu Twojego pytania? Napisz na{' '}
        <a class="link-ink text-ink" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
    <div class="min-w-0 border-t-2 border-ink">
      {faq.map((item) => (
        <details class="group border-b border-ink/25">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-display text-[clamp(1.3rem,2.2vw,1.65rem)] leading-tight font-semibold tracking-tight text-ink transition-colors hover:text-cobalt [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="relative grid size-9 shrink-0 place-items-center rounded-full border-2 border-current transition-transform duration-300 group-open:rotate-45 group-open:bg-cobalt group-open:text-paper" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <p class="max-w-[40rem] pb-7 text-lg text-ink-soft">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
