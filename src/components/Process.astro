---
import { SITE } from '../lib/site.js';

const steps = [
  { name: 'Rozmowa', when: '30 minut', price: '0 zł', text: 'Opowiadasz, jak wygląda Twój dzień i co Cię spowalnia. Bez prezentacji i bez żargonu.' },
  { name: 'Plan', when: 'kilka dni', price: 'wycena', text: 'Dostajesz krótki plan: co zautomatyzować, ile to kosztuje i ile czasu odzyskasz. Decydujesz bez presji.' },
  { name: 'Wdrożenie', when: '1 do 4 tygodni', price: `od ${SITE.priceFrom}`, text: 'Buduję, testuję na Twoich danych i uczę zespół. Po starcie jestem w kontakcie.' },
];
---
<section id="wspolpraca" class="section">
  <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
    <div class="min-w-0">
      <h2 class="h-section text-ink">Trzy kroki i&nbsp;wiesz dokładnie, za co płacisz</h2>
      <p class="mt-6 max-w-[30rem] text-lg text-ink-soft">
        Każdy etap ma swój czas i cenę, zanim cokolwiek zaczniemy. Jeśli wdrożenie
        nie zadziała tak, jak ustaliliśmy, oddam pieniądze.
      </p>
    </div>
    <div class="receipt-shadow min-w-0">
      <div class="receipt text-[0.875rem] sm:p-8 sm:pb-12">
        <div class="row caps text-[0.72rem] text-ink-soft"><span>Poz.</span><span class="ml-3">Usługa</span><span>Czas / cena</span></div>
        <div class="rule"></div>
        <ol class="divide-y divide-dashed divide-ink/20">
          {steps.map((s, i) => (
            <li class="py-4">
              <div class="row text-[1rem] font-bold">
                <span class="text-stamp">{i + 1}</span>
                <span class="ml-2">{s.name}</span>
                <span class="lead" aria-hidden="true"></span>
                <span>{s.price}</span>
              </div>
              <div class="row text-ink-soft"><span class="ml-6">{s.when}</span></div>
              <p class="mt-2 ml-6 font-sans text-[0.95rem] leading-relaxed text-ink-soft">{s.text}</p>
            </li>
          ))}
        </ol>
        <div class="rule-double"></div>
        <div class="row text-[1rem] font-bold"><span class="caps">Gwarancja</span><span class="lead" aria-hidden="true"></span><span>zwrot pieniędzy</span></div>
        <div class="row text-[1rem] font-bold"><span class="caps">Ukryte koszty</span><span class="lead" aria-hidden="true"></span><span>0 zł</span></div>
      </div>
    </div>
  </div>
</section>
