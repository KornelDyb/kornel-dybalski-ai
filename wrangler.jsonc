{
  // Konfiguracja Cloudflare Workers. Build: npm run build, deploy: npx wrangler deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kornel-dybalski",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Nie kasuj zmiennych ustawionych w panelu Cloudflare przy każdym wdrożeniu.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  // Czat z AI: najwyżej 10 wiadomości na minutę z jednego adresu IP.
  "ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}
