# Adres webhooka z Make (Webhooks > Custom webhook). Zna go tylko serwer (funkcja /api/lead).
# Na Cloudflare: Workers & Pages > kornel-dybalski > Settings > Variables and Secrets > MAKE_WEBHOOK_URL (typ Secret).
# Lokalnie z wranglerem: wpisz tę samą linię do pliku .dev.vars.
MAKE_WEBHOOK_URL=

# Opcjonalnie: identyfikator strony w Umami Cloud (statystyki bez cookies).
# Bez tej wartości skrypt statystyk w ogóle się nie wczytuje. Na Cloudflare wpisz ją w Settings > Build > Build variables, bo jest potrzebna przy budowaniu.
PUBLIC_UMAMI_WEBSITE_ID=

# Demo na żywo (etap 13): adres /api/demo, wywoływany przez Make po wysłaniu formularza.
# Wszystkie poniżej ustaw w Cloudflare: Settings > Variables and Secrets.
ANTHROPIC_API_KEY=     # Secret: klucz z console.anthropic.com
ANTHROPIC_MODEL=       # opcjonalnie, domyślnie claude-opus-5-5
AI_PROVIDER=           # puste = Claude; "gemini" = Google Gemini; "openai" = OpenAI
GEMINI_API_KEY=        # Secret: klucz z aistudio.google.com (darmowy plan)
GEMINI_MODEL=          # Text: dokładna nazwa modelu z AI Studio
DEMO_SECRET=           # Secret: hasło, które Make wysyła w nagłówku X-Demo-Secret
DEMO_MODE=             # puste lub "test" = mail z pomysłami tylko do właściciela; "live" = do klienta
OWNER_EMAIL=           # opcjonalnie, domyślnie e-mail z src/lib/site.js
