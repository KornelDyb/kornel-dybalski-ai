# Adres webhooka z Make (Webhooks > Custom webhook). Zna go tylko serwer (funkcja /api/lead).
# Na Cloudflare: projekt Pages > Settings > Variables and Secrets > MAKE_WEBHOOK_URL (typ Secret).
# Lokalnie z wranglerem: wpisz tę samą linię do pliku .dev.vars.
MAKE_WEBHOOK_URL=

# Opcjonalnie: identyfikator strony w Umami Cloud (statystyki bez cookies).
# Bez tej wartości skrypt statystyk w ogóle się nie wczytuje. Na Cloudflare ustaw ją jako zwykłą zmienną (Text), bo jest potrzebna przy budowaniu.
PUBLIC_UMAMI_WEBSITE_ID=
